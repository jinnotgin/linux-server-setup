  # Auto-renews Let's Encrypt TLS certificates via Cloudflare DNS challenge
  # No port 80 needed
  tunnel-certbot:
    image: serversideup/certbot-dns-cloudflare
    container_name: tunnel-certbot
    restart: unless-stopped
    volumes:
      - {{HOST_SSL_DIR}}:/etc/letsencrypt
    environment:
      CLOUDFLARE_API_TOKEN: "{{CLOUDFLARE_API_TOKEN}}"
      CERTBOT_EMAIL: "{{CERT_EMAIL}}"
      CERTBOT_DOMAINS: "{{DOMAINS_CSV}}"
    healthcheck:
      test: ["CMD", "test", "-f", "/etc/letsencrypt/live/{{CERT_BASE_DOMAIN}}/fullchain.pem"]
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 10s
