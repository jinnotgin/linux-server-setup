  # Main TLS entry point: routes direct-domain traffic to backend services
  gateway-router:
    image: nginx:stable-alpine
    container_name: gateway-router
    restart: unless-stopped
    depends_on:
      tunnel-certbot:
        condition: service_healthy
    ports:
      - "{{GATEWAY_PORT}}:{{GATEWAY_PORT}}"
    volumes:
      - {{GATEWAY_CONF_PATH}}:/etc/nginx/nginx.conf:ro
      - {{GATEWAY_WWW_PATH}}:/usr/share/nginx/html:ro
    networks:
      - proxy_net
