  # Hysteria2 server - direct outbound using the server's own IP
  hysteria2:
    image: tobyxdd/hysteria:latest
    container_name: hysteria2
    restart: unless-stopped
    depends_on:
      tunnel-certbot:
        condition: service_healthy
    ports:
      - "8444:8444/udp"
      - "8444:8444/tcp"
    volumes:
      - {{HYSTERIA_CONFIG_PATH}}:/etc/hysteria.yaml:ro
      - {{HOST_SSL_DIR}}:/certs:ro
    networks:
      - proxy_net
    command: ["server", "-c", "/etc/hysteria.yaml"]
