  # VLESS proxy - direct connection, own TLS on dedicated ports
  vless-direct:
    image: ghcr.io/xtls/xray-core:latest
    container_name: vless-direct
    restart: unless-stopped
    depends_on:
      tunnel-certbot:
        condition: service_healthy
    volumes:
      - {{VLESS_DIRECT_CONFIG_PATH}}:/etc/xray/config.json:ro
      - {{HOST_SSL_DIR}}:/certs:ro
{{WARP_PORT_BINDINGS}}
    networks:
      - proxy_net
    command: ["run", "-config", "/etc/xray/config.json"]
